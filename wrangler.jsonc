{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fps-online-server",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-11-14",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomHub"] }
  ]
}
